# Supabase — from your project dashboard: Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only — never expose with a NEXT_PUBLIC_ prefix
SUPABASE_SERVICE_ROLE_KEY=

# Server-side only — 32 random bytes encoded as base64 (`openssl rand -base64 32`)
TELEGRAM_TOKEN_ENCRYPTION_KEY=

# AI Providers — configs in src/configs/{openai,nvidia-nim,openrouter}.ts
OPENAI_API_KEY=
OPENAI_BASE_URL=          # default: https://api.metisai.ir/openai/v1 (Metis)
TELEGRAM_AI_OPENAI_MODEL= # primary, default: gpt-4o-mini

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=      # default: https://integrate.api.nvidia.com/v1
TELEGRAM_AI_NVIDIA_MODEL= # fallback, default: meta/llama-3.3-70b-instruct

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=      # default: https://openrouter.ai/api/v1
NEXT_PUBLIC_SITE_URL=     # public HTTPS app URL; used for Telegram webhooks and OpenRouter HTTP-Referer
